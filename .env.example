# ── SMTP (mail sending) ─────────────────────────────────────────────
# Host and port of the mail server used to send order notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for SSL port 465, "false" for STARTTLS port 587
SMTP_SECURE=false

# Account that sends the emails (must be allowed for SMTP on the host).
SMTP_USER=orders@example.com
SMTP_PASS=your-smtp-password-or-app-password

# ── Mail recipients ─────────────────────────────────────────────────
# Sender address shown in the emails (usually same as SMTP_USER).
MAIL_FROM=orders@example.com
# Admin notification recipient — gets every new order.
MAIL_TO=admin@example.com

# ── Server ──────────────────────────────────────────────────────────
# Optional. Defaults to 3000.
PORT=3000
